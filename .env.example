# eBay developer keys (developer.ebay.com > Application Keys > Production)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_DEV_ID=
EBAY_ENV=production

# OpenAI (vision / product identification)
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-6-sol
# Cheap first-pass model; OPENAI_VISION_MODEL is used only below this confidence
OPENAI_VISION_FAST_MODEL=gpt-6-luna
OPENAI_VISION_ESCALATE_BELOW=0.8

# Google sign-in (OAuth client, type Web)
GOOGLE_CLIENT_ID=

# Stripe (test mode for development)
STRIPE_SECRET_KEY_TEST=
STRIPE_WEBHOOK_SECRET_TEST=
APP_URL=http://localhost:5173

# Comma separated Google emails that can open /admin
ADMIN_EMAILS=

# Local Postgres
DATABASE_URL=postgres://localhost:5432/fliplens
