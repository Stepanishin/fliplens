# eBay developer keys (developer.ebay.com > Application Keys > Production)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_DEV_ID=
EBAY_ENV=production

# OpenAI (vision / product identification)
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-6-sol
# Cheap first-pass model; OPENAI_VISION_MODEL is used only below this confidence
OPENAI_VISION_FAST_MODEL=gpt-6-luna
OPENAI_VISION_ESCALATE_BELOW=0.8

# Google sign-in (OAuth client, type Web)
GOOGLE_CLIENT_ID=

# Stripe (test mode for development)
STRIPE_SECRET_KEY_TEST=
STRIPE_WEBHOOK_SECRET_TEST=
APP_URL=http://localhost:5173

# Comma separated Google emails that can open /admin
ADMIN_EMAILS=

# Developer benchmark tool (stores photos on disk; admin-only). Never in production.
ENABLE_BENCHMARK=0

# ---- production only ----
# HOST=0.0.0.0
# PORT=8080
# TRUST_PROXY=1
# STRIPE_SECRET_KEY=sk_live_...   (plus STRIPE_ALLOW_LIVE=1; do NOT set the *_TEST variables in production)
# STRIPE_WEBHOOK_SECRET=whsec_... (from the dashboard webhook endpoint)
# STRIPE_REQUIRE_TERMS=1          (after setting the Terms URL in Stripe > Settings > Public details)
# STRIPE_AUTOMATIC_TAX=1          (after setting up Stripe Tax)
# APP_URL=https://your-domain

# Local Postgres
DATABASE_URL=postgres://localhost:5432/fliplens
