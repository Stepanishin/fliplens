{
  "name": "@fliplens/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "start": "tsx --env-file=../../.env src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "stripe:setup": "tsx --env-file=../../.env scripts/stripe-setup.ts",
    "stripe:listen": "sh -c 'set -a; . ../../.env; stripe listen --api-key \"$STRIPE_SECRET_KEY_TEST\" --forward-to localhost:8787/api/stripe/webhook'"
  },
  "dependencies": {
    "@fliplens/core": "workspace:*",
    "@fliplens/db": "workspace:*",
    "@fliplens/eval": "workspace:*",
    "@fliplens/recognition": "workspace:*",
    "@fliplens/sources": "workspace:*",
    "fastify": "^5.0.0",
    "jose": "^6.2.12",
    "stripe": "^22.6.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  }
}
