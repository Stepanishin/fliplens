{
  "name": "@fliplens/extension",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "FLIPLENS_URL=http://localhost:5173 node scripts/build.mjs --watch",
    "zip": "node scripts/build.mjs && cd dist && zip -qr ../fliplens-extension.zip .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@fliplens/core": "workspace:*",
    "@fliplens/recognition": "workspace:*"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "esbuild": "^0.25.12"
  }
}
